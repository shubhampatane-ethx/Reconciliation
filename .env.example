# =====================================================================
# Reconciliation Platform Environment Configuration Template
# Copy this file to .env and edit values for your deployment.
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND CONFIGURATION (Machine 2 or Client Device)
# ---------------------------------------------------------------------
# Point this to your Backend API server location:
# - Local Wi-Fi IP: http://192.168.1.50:5000
# - Ngrok Backend Tunnel: https://your-backend.ngrok-free.app
# Default if empty: http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------
# BACKEND CONFIGURATION (Machine 1)
# ---------------------------------------------------------------------
# Points to your external/remote Ollama server instance:
# - Wi-Fi IP & Port: http://100.93.93.84:11434
# - Public Tunnel: https://your-ollama-tunnel.trycloudflare.com
# Default if empty: http://100.93.93.84:11434
OLLAMA_BASE_URL=http://100.93.93.84:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# Primary Groq AI API Key (Get a free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Security Token Secret (Change to a long random string in production)
JWT_SECRET=replace-this-with-a-secure-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database URLs (Docker defaults)
DATABASE_URL=postgresql://consistency:consistency@db:5432/consistency
DUMMY_SERVER_DATABASE_URL=postgresql+psycopg2://postgres:Swamiom%401702%23@target_db:5432/Target_Data
